# ============================================================================
# KINÉDOUX™ (api.kinedoux.com) — BACKEND ENVIRONMENT VARIABLES (EASYPANEL)
# ============================================================================

# 1. Server & Environment
APP_ENV=production
PORT=8000
SITE_URL=https://kinedoux.com
FRONTEND_URL=https://kinedoux.com
CORS_ORIGINS=https://kinedoux.com,https://www.kinedoux.com

# 2. PostgreSQL — paste the EasyPanel INTERNAL url exactly.
# The app converts postgres:// to postgresql+psycopg2:// and keeps sslmode.
DATABASE_URL=postgres://kinedoux:kinedoux@kinedoux_database:5432/kinedoux?sslmode=disable

# 3. Google Sheets (leave the URL empty until the Apps Script is deployed)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
UPSELL_AUTO_FINALIZE_SECONDS=20
FORWARD_CONTACT_TO_SHEET=false

# 4. Phone validation: MA for Morocco. Keep identical to the frontend value.
PHONE_VALIDATION_MODE=MA

# 5. Meta Conversions API
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# 6. TikTok Events API
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# 7. Snapchat Conversions API
SNAP_PIXEL_ID=
SNAP_CAPI_ACCESS_TOKEN=
