# ============================================================================
# KINÉDOUX™ (api.kenidoux.com.shop) — BACKEND ENVIRONMENT VARIABLES (EASYPANEL)
# ============================================================================

# 1. Server & Environment
APP_ENV=production
PORT=8000
SITE_URL=https://kenidoux.com
FRONTEND_URL=https://kenidoux.com
CORS_ORIGINS=https://kenidoux.com,https://www.kenidoux.com,https://api.kenidoux.com.shop,http://localhost:3000

# 2. PostgreSQL Database Connection (EasyPanel Internal URL)
# Both `/namabeauty` and `/kenidoux` database names and the `postgres://` prefix are supported:
# the backend converts it to postgresql+psycopg2:// automatically and keeps ?sslmode=disable.
DATABASE_URL=postgres://kenidoux:kenidoux@kenidoux_database:5432/namabeauty?sslmode=disable

# 3. Google Sheets Apps Script Webhook (deploy sheets/google_apps_script_webhook.js, paste the /exec URL)
#    Leave the placeholder (or empty) to disable the sheet dispatch until you have the real URL.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=kenidoux_sheet_secret_2026
# Seconds before the backend auto-finalizes an order if the customer closes the tab during the 15s upsell
UPSELL_AUTO_FINALIZE_SECONDS=20
# Also forward /contact messages to a second "contact" tab of the Sheet (requires the updated Apps Script)
FORWARD_CONTACT_TO_SHEET=false

# 4. Phone validation: KSA | MA | BOTH (keep identical to NEXT_PUBLIC_PHONE_VALIDATION_MODE)
PHONE_VALIDATION_MODE=BOTH

# 5. Meta (Facebook/Instagram) Conversions API (CAPI)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# 6. TikTok Events API v1.3 (CAPI)
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_TEST_EVENT_CODE=

# 7. Snapchat Conversions API v3 (CAPI)
SNAP_PIXEL_ID=
SNAP_CAPI_ACCESS_TOKEN=
