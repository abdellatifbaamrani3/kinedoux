# ============================================================================
# KINÉDOUX™ (kinedoux.com) — FRONTEND ENVIRONMENT VARIABLES (EASYPANEL)
# Set these as Environment AND as Build arguments. NEXT_PUBLIC_* is inlined
# into the browser bundle at build time.
# ============================================================================

# 1. Public URLs
NEXT_PUBLIC_SITE_URL=https://kinedoux.com
NEXT_PUBLIC_API_URL=https://api.kinedoux.com

# Server-only. Used by the contact route to email the inbox behind contact@kinedoux.com.
# Leave empty in production until the Cloudflare token is set on the host.
API_PROXY_TARGET=https://api.kinedoux.com
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CONTACT_FROM_EMAIL=contact@kinedoux.com
CONTACT_TO_EMAIL=abdellatifbaamrani3@gmail.com

# 2. Phone Validation Mode
# MA = Moroccan 06/07/+212 only. Use this for the Morocco COD store.
NEXT_PUBLIC_PHONE_VALIDATION_MODE=MA

# 3. WhatsApp Customer Support Number (digits only, no '+')
NEXT_PUBLIC_WHATSAPP_NUMBER=212600000000

# 4. Web Pixels (leave empty until the ad accounts exist)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=

# 5. Store Currency & Upsell Timer
NEXT_PUBLIC_CURRENCY=MAD
NEXT_PUBLIC_UPSELL_TIMER_SECONDS=15
