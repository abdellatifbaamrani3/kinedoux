---
import '../styles/site.css';
import { site, localizePath, type Lang } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Path without the language prefix, always with slashes. Example: /lumba/ */
  path: string;
  ogImage?: string;
  preloadImage?: string;
  noindex?: boolean;
  dock?: boolean;
  price?: number;
}

const {
  title,
  description,
  lang,
  path,
  ogImage,
  preloadImage,
  noindex = false,
  dock = false,
  price,
} = Astro.props;

const dir = lang === 'ar' ? 'rtl' : 'ltr';
const canonicalPath = localizePath(path, lang);
const canonical = new URL(canonicalPath, Astro.site);
const arUrl = new URL(localizePath(path, 'ar'), Astro.site);
const frUrl = new URL(localizePath(path, 'fr'), Astro.site);
const image = ogImage ? new URL(ogImage, Astro.site).href : '';
const pixelId = site.pixelId;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang="ar" href={arUrl.href} />
    <link rel="alternate" hreflang="fr" href={frUrl.href} />
    <link rel="alternate" hreflang="x-default" href={arUrl.href} />
    <meta name="theme-color" content="#1e4d3b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={price ? 'product' : 'website'} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_MA' : 'fr_MA'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {image && <meta property="og:image" content={image} />}
    {price && <meta property="product:price:amount" content={String(price)} />}
    {price && <meta property="product:price:currency" content="MAD" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        type="image/avif"
        fetchpriority="high"
      />
    )}
    {/*
      Pixel stub only. The heavy fbevents.js file is inserted on window load.
      Calls made before that stay in fbq.queue and flush when the file arrives.
      eventID is passed on every track() so a later Conversions API webhook can dedupe.
    */}
    {pixelId && (
      <script define:vars={{ pixelId }}>
        (function (id) {
          if (!/^\d{8,20}$/.test(id)) return;
          var fbq = (window.fbq = function () {
            fbq.callMethod ? fbq.callMethod.apply(fbq, arguments) : fbq.queue.push(arguments);
          });
          if (!window._fbq) window._fbq = fbq;
          fbq.push = fbq;
          fbq.loaded = true;
          fbq.version = '2.0';
          fbq.queue = [];
          var pageId =
            (window.crypto && crypto.randomUUID && crypto.randomUUID()) ||
            'pv-' + Date.now();
          fbq('init', id);
          fbq('track', 'PageView', {}, { eventID: pageId });
          window.addEventListener('load', function () {
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://connect.facebook.net/en_US/fbevents.js';
            document.head.appendChild(s);
          });
        })(pixelId);
      </script>
    )}
    {pixelId && (
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          alt=""
          src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
        />
      </noscript>
    )}
  </head>
  <body class={dock ? 'has-dock' : ''} data-pixel={pixelId}>
    <Header lang={lang} path={path} />
    <slot />
    <Footer lang={lang} />
  </body>
</html>
